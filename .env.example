# Copiar a .env (nunca versionar .env). Los secretos también pueden ir en el Llavero de macOS:
#   security add-generic-password -s mobile-qa-agent -a QA_PASSWORD -w '<valor>'

# Ambiente lógico (ver config/environments/*.yaml)
QA_ENV=prod-readonly

# Carpeta de perfiles de app (por defecto ./profiles; puede ser un clon del catálogo público de perfiles)
# QA_PROFILES_DIR=

# Toolchain (se autodetecta si no se define)
# JAVA_HOME=/opt/homebrew/opt/openjdk@21/libexec/openjdk.jdk/Contents/Home
# ANDROID_HOME=/opt/homebrew/share/android-commandlinetools

# Appium
APPIUM_URL=http://127.0.0.1:4723
APPIUM_AUTOSTART=true

# Credenciales de cuenta de PRUEBA autorizada (solo si session.mode = credentials)
QA_USERNAME=
QA_PASSWORD=

# iOS dispositivo físico
IOS_XCODE_ORG_ID=
IOS_XCODE_SIGNING_ID=iPhone Developer
IOS_WDA_BUNDLE_ID=

# Capa de IA. none = deshabilitada
LLM_PROVIDER=none
LLM_API_KEY=
